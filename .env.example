# Supabase 연동 환경 변수
NEXT_PUBLIC_SUPABASE_URL=본인의_Supabase_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=본인의_Supabase_Anon_Key
SUPABASE_SERVICE_ROLE_KEY=본인의_Supabase_Service_Role_Key

# 웹 푸시 인증용 VAPID 키 (터미널에서 npx web-push generate-vapid-keys 로 생성)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=여기에_공개키(Public_Key)_입력
VAPID_PRIVATE_KEY=여기에_비밀키(Private_Key)_입력
